      "character": "PRESENTADOR",
      "text": "¡Buenos días! Bienvenidos a TechPulse, su resumen diario de noticias tecnológicas.",
      "voice_id": "homer",
      "emotion": null,
      "sfx_cue": null,
      "sfx_volume": 0.2,
      "pause_before_ms": 300,
      "pause_after_ms": 500,
      "scene_mark": null
    },
    {
      "character": "PRESENTADORA",
      "text": "Y yo soy Dalia. Hoy hablaremos de los avances más recientes en inteligencia artificial.",
      "voice_id": "dalia",
      "emotion": null,
      "sfx_cue": null,
      "sfx_volume": 0.2,
      "pause_before_ms": 300,
      "pause_after_ms": 500,
      "scene_mark": null
    },
    {
