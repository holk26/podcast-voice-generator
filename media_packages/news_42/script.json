      "text": "Y cerramos con OpenAI, que abrió el preview de GPT-5 para desarrolladores. Los primeros benchmarks muestran mejoras claras en razonamiento y programación.",
      "voice_id": "dalia",
      "emotion": null,
      "sfx_cue": null,
      "sfx_volume": 0.2,
      "pause_before_ms": 300,
      "pause_after_ms": 500,
      "scene_mark": null
    },
    {
